    {
      "id": "5qwc0iIFRRtzs-saiNY37",
      "type": "text",
      "x": 1189.1334998721168,
      "y": 127.86608428414795,
      "width": 1318.0986328125,
      "height": 1674,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
